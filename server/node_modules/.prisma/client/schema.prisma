generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ProjectType {
  WEB_APP
  FULL_STACK
  DASHBOARD
  ECOMMERCE
  STUDENT_SYSTEM
  PORTFOLIO
  OTHER
}

enum ProjectStatus {
  DRAFT
  BUILDING
  READY
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionType {
  FREE_BUILD_USED
  CREDIT_PURCHASE
  PURCHASE
  CREDIT_USED
  REFUND
}

model User {
  id                   String       @id @default(uuid())
  name                 String?
  email                String       @unique
  password             String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  profileImage         String?
  authProvider         AuthProvider @default(LOCAL)
  providerAccountId    String?
  role                 Role         @default(USER)
  credits              Int          @default(0)
  freeBuildsUsed       Int          @default(0)
  freeBuildsTotal      Int          @default(3)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  projects           Project[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  usageHistories     UsageHistory[]
}

model Project {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  type          String           @default("FULL_STACK")
  entryHtml     String?          @db.Text
  isDeployed    Boolean          @default(false)
  isPublic      Boolean          @default(false)
  forkedFromId  String?
  deployedUrl   String?
  slug          String?          @unique
  files         ProjectFile[]
  versions      ProjectVersion[]
  conversations Conversation[]
  deployments   Deployment[]
  usageHistory  UsageHistory[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
}

model ProjectVersion {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt    String   @db.Text
  entryHtml String   @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  name      String
  path      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model Conversation {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  sender         String // "user" or "assistant"
  text           String   @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CreditPackage {
  id         String   @id @default(uuid())
  name       String
  credits    Int
  priceInInr Int // In INR (₹)
  popular    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payments Payment[]
}

model CreditTransaction {
  id           String          @id @default(uuid())
  userId       String
  type         TransactionType
  amount       Int
  balanceAfter Int
  description  String
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  creditPackageId   String?
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Int // In INR (₹)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  creditsGranted    Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditPackage CreditPackage? @relation(fields: [creditPackageId], references: [id])

  @@index([userId])
}

model Deployment {
  id          String   @id @default(uuid())
  projectId   String
  provider    String   @default("RENDER")
  deployedUrl String?
  slug        String?  @unique
  status      String   @default("PENDING")
  logs        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model UsageHistory {
  id          String   @id @default(uuid())
  userId      String
  projectId   String?
  action      String
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
}
